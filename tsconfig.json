{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM lib. ADR 0008 requires the simulation core to have no DOM access, and this is
    // what makes that a compile error rather than a convention: `document` and `window`
    // are simply not there. Node's types are here for the test runner and for the
    // architecture guard in src/core/core-is-pure.test.ts, which reads the core's own
    // source and is what keeps a wall clock out of it.
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
