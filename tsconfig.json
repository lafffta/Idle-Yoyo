{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM lib. ADRs 0008 and 0012 require the core and tuning harness to have no DOM
    // access, and this is what makes that a compile error rather than a convention.
    // The shell is checked separately by tsconfig.app.json, which adds browser types.
    "lib": ["ES2022"],
    "types": ["node"],
    // Vite reads the root config when it transforms shell TSX; the shell-only config below
    // still owns DOM types and which files TypeScript checks (ADR 0012).
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["src/core", "src/tuning"]
}
